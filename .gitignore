# Virtual environment
venv/
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Data and results are regenerated by the pipeline, so only code is tracked.
data/*.csv
outputs/*

# ...but keep the directory structure itself in the repo.
!data/.gitkeep
!outputs/.gitkeep

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
